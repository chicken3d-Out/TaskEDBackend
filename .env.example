# Server
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:4200

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=tasked
DB_PASSWORD=change_me
DB_DATABASE=tasked

# JWT
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=8h

# Google OAuth (restricted to deped.gov.ph)
# Create these in Google Cloud Console > APIs & Services > Credentials
# Authorized redirect URI: {PORT/host}/auth/google/callback
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback
ALLOWED_EMAIL_DOMAIN=deped.gov.ph

# AI Chatbot (OpenRouter - https://openrouter.ai/keys)
OPENROUTER_API_KEY=sk-or-v1-your-key-here
# Free lineup shifts over time - check https://openrouter.ai/collections/free-models
OPENROUTER_MODEL=deepseek/deepseek-v4-flash:free

# File storage - Cloudinary (ticket attachments, update images, profile pictures)
# Free account: https://cloudinary.com  ->  Dashboard shows these three values.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Push notifications (Firebase Cloud Messaging, used by the Ionic/Capacitor
# mobile app only - the web app has no equivalent). Create a Firebase
# project, add an Android/iOS app to it, then Project Settings > Service
# Accounts > Generate new private key. Paste the ENTIRE downloaded JSON
# file's contents here as one line (or base64-encode it first - either
# works). Leave unset to run without push notifications; everything else
# keeps working.
FIREBASE_SERVICE_ACCOUNT_JSON=
MOBILE_APP_SCHEME=ph.gov.deped.leyte.tasked

# Set to true when connecting to a hosted DB from outside (e.g. Render External URL)
DB_SSL=false

# First Administrator (username + password sign-in). Created at startup if
# it does not exist. Use a strong password (10+ characters).
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Set true for ONE start to reset that administrator's password, then remove.
ADMIN_RESET_PASSWORD=false
# Set true once to insert schools from src/database/seeds/schools.json at startup
SEED_SCHOOLS_ON_BOOT=false
